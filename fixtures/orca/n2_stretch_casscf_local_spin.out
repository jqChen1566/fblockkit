NAME = n2_stretch_casscf_local_spin.inp
|  1> # Fixture: stretched N2 (2.2 A), CASSCF(6,6) with 2 singlet roots and the
|  2> # molecule divided into two fragments - the CASSCF variant of the local spin
|  3> # analysis (per-root printing).
|  4> ! RHF def2-SVP def2-SVP/C TightSCF
|  5> %pal nprocs 2 end
|  6> %maxcore 2000
|  7> %casscf
|  8>   nel 6
|  9>   norb 6
| 10>   mult 1
| 11>   nroots 2
| 12> end
| 13> * xyz 0 1
| 14> N(1) 0 0 0
| 15> N(2) 0 0 2.2
| 16> *
| 17> 
| 18>                          ****END OF INPUT****
