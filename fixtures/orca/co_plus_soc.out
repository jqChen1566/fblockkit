NAME = co_plus_soc.inp
|  1> # 夹具：CO+ QD-NEVPT2 + SOC（多自旋多重度，用于 soc_present 检测）
|  2> # 输入结构参照 ORCA 6.1 手册 §3.13（CASSCF 的 SOC 由 rel 子块 DoSOC 触发）
|  3> ! NEVPT2 def2-SVP def2-SVP/C TightSCF
|  4> %pal nprocs 4 end
|  5> %maxcore 2000
|  6> %casscf
|  7>   nel 9
|  8>   norb 8
|  9>   mult 2,4
| 10>   nroots 3,3
| 11>   rel
| 12>     DoSOC true
| 13>     PrintLevel 2
| 14>   end
| 15> end
| 16> * xyz 1 2
| 17> C 0 0 0
| 18> O 0 0 1.13
| 19> *
| 20> 
| 21>                          ****END OF INPUT****
