NAME = fecl4_v6.inp
|  1> # [Fe(II)Cl4]2- - ROCIS - L-edge XAS + RIXS (Wave 5.4 probe)
|  2> !x2c x2c-SVPall AutoAux TightSCF
|  3> %pal nprocs 8 end
|  4> %maxcore 4000
|  5> %scf
|  6>   HFTyp ROHF
|  7>   ROHF_CASE HIGHSPIN
|  8>   ROHF_NEL[1] 4
|  9> end
| 10> %rocis
| 11>   DoGenROCIS true
| 12>   ReferenceMult 5
| 13>   NRoots 10
| 14>   OrbWin 6,8,0,2000
| 15>   DoPNO true
| 16>   TCutPNO 1e-11
| 17>   XASelems 0
| 18>   rel
| 19>     DoSOC true
| 20>     DoRIXS true
| 21>     DoRIXSSOC true
| 22>     DoElastic true
| 23>   end
| 24>   DoHigherMult true
| 25>   DoLowerMult true
| 26>   DoRI true
| 27>   Decomposefosc true
| 28> end
| 29> *xyz -2 5
| 30> Fe -0.009575 0.000087 0.011550
| 31> Cl -1.774578 -1.558533 -0.219791
| 32> Cl -0.681385 1.874633 1.289404
