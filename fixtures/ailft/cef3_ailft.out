NAME = cef3_ailft.inp
|  1> !NEVPT2 def2-SVP def2-SVP/C TightSCF SlowConv
|  2> %pal nprocs 8 end
|  3> %maxcore 4000
|  4> %casscf
|  5>   nel 1
|  6>   norb 7
|  7>   LFTCase 4f
|  8>   mult 2
|  9>   nroots 7
| 10>   rel
| 11>     dosoc true
| 12>   end
| 13> end
| 14> *xyz 0 2
| 15> Ce 0.000 0.000 0.000
| 16> F  2.200 0.000 0.000
| 17> F -1.100 1.905 0.000
| 18> F -1.100 -1.905 0.000
| 19> *
| 20> 
| 21>                          ****END OF INPUT****
